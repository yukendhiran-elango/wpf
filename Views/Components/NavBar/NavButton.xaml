<UserControl x:Class="Master.Views.Components.NavBar.NavButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Master.Views.Components.NavBar"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
	<Border
		MouseLeftButtonUp="OnClick"
        Cursor="Hand"
        Margin="8,0"
        CornerRadius="8"
        Background="{DynamicResource NavButtonDefaultBrush}">
		<Border.Style>
			<Style TargetType="Border">
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
					</Trigger>
					<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
						<Setter Property="Background" Value="{DynamicResource NavButtonActiveBrush}"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>

		<StackPanel Width="66" Orientation="Vertical" HorizontalAlignment="Center">

			<ui:SymbolIcon
                Symbol="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="20"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource NavIconDefaultBrush}">
				<ui:SymbolIcon.Style>
					<Style TargetType="ui:SymbolIcon">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource NavIconActiveBrush}"/>
							</DataTrigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource NavIconHoverBrush}"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</ui:SymbolIcon.Style>
			</ui:SymbolIcon>

			<ui:TextBlock
                Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource NavIconDefaultBrush}">
				<ui:TextBlock.Style>
					<Style TargetType="ui:TextBlock">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource NavIconActiveBrush}"/>
							</DataTrigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{DynamicResource NavIconHoverBrush}"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</ui:TextBlock.Style>
			</ui:TextBlock>

		</StackPanel>

	</Border>
	
	
</UserControl>
