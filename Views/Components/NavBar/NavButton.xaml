<UserControl x:Class="Master.Views.Components.NavBar.NavButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Master.Views.Components.NavBar"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
			 Height="70" Width="80">
	<Border MouseLeftButtonUp="OnClick"
            Cursor="Hand"
            Margin="2"
            Padding="4"
            CornerRadius="8"
            Background="Transparent" 
            x:Name="MainBorder">
		<Border.Style>
			<Style TargetType="Border">
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="#15FFFFFF"/>
					</Trigger>
					<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
						<Setter Property="Background" Value="{DynamicResource Brush.NavbarAccent}"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>

		<Grid>
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
				<ui:SymbolIcon
                    Symbol="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="22"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Brush.Foreground}"/>

				<ui:TextBlock
                    Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="11"
                    TextAlignment="Center"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" 
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Brush.Foreground}"/>
			</StackPanel>
		</Grid>
	</Border>
	
	
</UserControl>
