<UserControl x:Class="Master.Views.Components.Header.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Master.Views.Components.Header"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:theme="clr-namespace:Master.Themes">

	<Border BorderThickness="0,0,0,1" 
            Padding="16,6" 
            BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Background}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Orientation="Horizontal">
				<ui:SymbolIcon Symbol="CheckmarkCircle24" 
                               FontSize="26" 
                               Foreground="{DynamicResource Brush.Success}" 
                               VerticalAlignment="Center"/>
				<StackPanel Margin="12,0" VerticalAlignment="Center">
					<TextBlock Text="BGA - Final Cure" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Foreground}"/>
					<TextBlock Text="Machine Normal" FontSize="11" Foreground="{DynamicResource Brush.MutedForeground}"/>
				</StackPanel>
				<Rectangle Width="1" Fill="{DynamicResource Brush.Border}" Margin="16,6"/>
			</StackPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
				<Border CornerRadius="6" Padding="4" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<ui:Button Icon="{ui:SymbolIcon Symbol=ArrowClockwise20}" ToolTip="Replay" Appearance="Transparent" Foreground="{DynamicResource Brush.WarningYellow}" Width="36" Height="34" Margin="2,0"/>
						<ui:Button  Icon="{ui:SymbolIcon Symbol=Play20}" ToolTip="Play" Foreground="{DynamicResource Brush.Info}" Appearance="Transparent" Width="36" Height="34" Margin="2,0"/>
						<ui:Button  Icon="{ui:SymbolIcon Symbol=Pause20}" ToolTip="Pause" Appearance="Transparent" Foreground="{DynamicResource Brush.Success}" Width="36" Height="34" Margin="2,0"/>
						<ui:Button  Icon="{ui:SymbolIcon Symbol=Stop20}" ToolTip="Stop" Foreground="{DynamicResource Brush.FailedRed}" Appearance="Transparent" Width="36" Height="34" Margin="2,0"/>
					</StackPanel>
				</Border>

				<Rectangle Width="1" Fill="{DynamicResource Brush.Border}" Margin="16,8"/>

				<TextBlock Text="V 1.2.334" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.MutedForeground}"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<ui:Button Icon="{ui:SymbolIcon Symbol=Settings20}" Foreground="{DynamicResource Brush.Foreground}" Appearance="Transparent" Margin="0,0,8,0"/>

				<StackPanel VerticalAlignment="Center" Margin="8,0">
					<TextBlock Text="ADMIN" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Foreground}"/>
					<TextBlock Text="09:12:43 AM" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.MutedForeground}"/>
				</StackPanel>

				<theme:ThemeToggle Margin="8,0,0,0"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
