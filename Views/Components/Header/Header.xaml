<UserControl x:Class="Master.Views.Components.Header.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Master.Views.Components.Header"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

	<Border BorderThickness="0,0,0,1" Padding="12">

		<Grid>
			<!-- MAIN COLUMNS -->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- LEFT : Machine status -->
			<StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

				<ui:SymbolIcon Symbol="CheckmarkCircle24"
                               FontSize="20"/>

				<StackPanel Margin="8,0,0,0">
					<TextBlock Text="BGA - Final Cure"
                               FontWeight="SemiBold"/>
					<TextBlock Text="Machine Normal"
                               FontSize="12"/>
				</StackPanel>
			</StackPanel>

			<!-- CENTER : split into rows -->
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- ROW 0 : right-aligned stackpanel -->
				<StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
					<TextBlock Text="Project Code : V57"
                               FontSize="12"
                               FontWeight="SemiBold"/>
				</StackPanel>

				
			</Grid>

			<!-- RIGHT : Actions -->
			<StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<StackPanel Grid.Row="1"></StackPanel>
					<StackPanel Grid.Row="2"></StackPanel>
				</Grid>
				</StackPanel>

		</Grid>
	</Border>
</UserControl>
