<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radius -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">12</CornerRadius>

    <!-- Shadow -->
    <DropShadowEffect x:Key="Shadow.Sm"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Opacity="0.15"/>

    <DropShadowEffect x:Key="Shadow.Md"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.18"/>

    <DropShadowEffect x:Key="Shadow.Lg"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Opacity="0.22"/>
    
</ResourceDictionary>