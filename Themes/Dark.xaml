<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Like CSS variables for dark theme -->
    
    <!-- Primary Colors -->
    <Color x:Key="PrimaryColor">#4080D4</Color>
    <Color x:Key="PrimaryHoverColor">#5090E4</Color>
    <Color x:Key="PrimaryActiveColor">#3070C4</Color>
    
    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="CardColor">#252525</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#C8C6C4</Color>
    <Color x:Key="DisabledTextColor">#6D6D6D</Color>
    
    <!-- Border Colors -->
    <Color x:Key="BorderColor">#3F3F3F</Color>
    <Color x:Key="FocusBorderColor">#4080D4</Color>
    
    <!-- Navigation Colors -->
    <Color x:Key="NavButtonDefaultColor">#252525</Color>
    <Color x:Key="NavButtonHoverColor">#2D2D2D</Color>
    <Color x:Key="NavButtonActiveColor">#4080D4</Color>
    <Color x:Key="NavIconDefaultColor">#C8C6C4</Color>
    <Color x:Key="NavIconHoverColor">#FFFFFF</Color>
    <Color x:Key="NavIconActiveColor">#FFFFFF</Color>
    
    <!-- Convert Colors to Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>
    
    <SolidColorBrush x:Key="NavButtonDefaultBrush" Color="{StaticResource NavButtonDefaultColor}"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="{StaticResource NavButtonHoverColor}"/>
    <SolidColorBrush x:Key="NavButtonActiveBrush" Color="{StaticResource NavButtonActiveColor}"/>
    <SolidColorBrush x:Key="NavIconDefaultBrush" Color="{StaticResource NavIconDefaultColor}"/>
    <SolidColorBrush x:Key="NavIconHoverBrush" Color="{StaticResource NavIconHoverColor}"/>
    <SolidColorBrush x:Key="NavIconActiveBrush" Color="{StaticResource NavIconActiveColor}"/>

</ResourceDictionary>