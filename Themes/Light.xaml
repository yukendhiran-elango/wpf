<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!-- BASE -->
    <!-- ========================= -->

    <Color x:Key="Color.Background">#FAFAFA</Color>
    <Color x:Key="Color.Foreground">#525252</Color>

    <Color x:Key="Color.Card">#FFFFFF</Color>
    <Color x:Key="Color.CardForeground">#525252</Color>

    <Color x:Key="Color.Popover">#FFFFFF</Color>
    <Color x:Key="Color.PopoverForeground">#525252</Color>

    <!-- ========================= -->
    <!-- BRAND -->
    <!-- ========================= -->

    <Color x:Key="Color.Primary">#6B5CFF</Color>
    <Color x:Key="Color.PrimaryForeground">#FFFFFF</Color>

    <Color x:Key="Color.Secondary">#C7D6F2</Color>
    <Color x:Key="Color.SecondaryForeground">#525252</Color>

    <Color x:Key="Color.Accent">#9BE3B2</Color>
    <Color x:Key="Color.AccentForeground">#FFFFFF</Color>

    <!-- ========================= -->
    <!-- MUTED / STATE -->
    <!-- ========================= -->

    <Color x:Key="Color.Muted">#E6E4D8</Color>
    <Color x:Key="Color.MutedForeground">#8A8A8A</Color>

    <Color x:Key="Color.Destructive">#F05A4F</Color>
    <Color x:Key="Color.DestructiveForeground">#FFFFFF</Color>

    <!-- ========================= -->
    <!-- UI -->
    <!-- ========================= -->

    <Color x:Key="Color.Border">#DEDEDE</Color>
    <Color x:Key="Color.Input">#DEDEDE</Color>
    <Color x:Key="Color.Ring">#6B5CFF</Color>

    <!-- ========================= -->
    <!-- CHART -->
    <!-- ========================= -->

    <Color x:Key="Color.Chart1">#6B5CFF</Color>
    <Color x:Key="Color.Chart2">#8B6EFF</Color>
    <Color x:Key="Color.Chart3">#6C3ECF</Color>
    <Color x:Key="Color.Chart4">#7FA9E3</Color>
    <Color x:Key="Color.Chart5">#7AA0C8</Color>

    <!-- ========================= -->
    <!-- NAVBAR (renamed from sidebar) -->
    <!-- ========================= -->

    <Color x:Key="Color.Navbar">#FAFAFA</Color>
    <Color x:Key="Color.NavbarForeground">#525252</Color>
    <Color x:Key="Color.NavbarPrimary">#6B5CFF</Color>
    <Color x:Key="Color.NavbarPrimaryForeground">#FFFFFF</Color>
    <Color x:Key="Color.NavbarAccent">#9BE3B2</Color>
    <Color x:Key="Color.NavbarAccentForeground">#FFFFFF</Color>
    <Color x:Key="Color.NavbarBorder">#DEDEDE</Color>
    <Color x:Key="Color.NavbarRing">#6B5CFF</Color>

    <!-- ========================= -->
    <!-- INDUSTRIAL STATUS COLORS -->
    <!-- ========================= -->

    <!-- SUCCESS / NORMAL -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.SuccessForeground">#FFFFFF</Color>

    <!-- WARNING / YELLOW -->
    <Color x:Key="Color.WarningYellow">#EAB308</Color>
    <Color x:Key="Color.WarningYellowForeground">#1F2937</Color>

    <!-- ERROR / ORANGE -->
    <Color x:Key="Color.ErrorOrange">#F97316</Color>
    <Color x:Key="Color.ErrorOrangeForeground">#FFFFFF</Color>

    <!-- FAILED / RED -->
    <Color x:Key="Color.FailedRed">#DC2626</Color>
    <Color x:Key="Color.FailedRedForeground">#FFFFFF</Color>

    <!-- INFO -->
    <Color x:Key="Color.Info">#2563EB</Color>
    <Color x:Key="Color.InfoForeground">#FFFFFF</Color>


    <!-- ========================= -->
    <!-- STATUS BRUSHES -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessForeground" Color="{StaticResource Color.SuccessForeground}"/>

    <SolidColorBrush x:Key="Brush.WarningYellow" Color="{StaticResource Color.WarningYellow}"/>
    <SolidColorBrush x:Key="Brush.WarningYellowForeground" Color="{StaticResource Color.WarningYellowForeground}"/>

    <SolidColorBrush x:Key="Brush.ErrorOrange" Color="{StaticResource Color.ErrorOrange}"/>
    <SolidColorBrush x:Key="Brush.ErrorOrangeForeground" Color="{StaticResource Color.ErrorOrangeForeground}"/>

    <SolidColorBrush x:Key="Brush.FailedRed" Color="{StaticResource Color.FailedRed}"/>
    <SolidColorBrush x:Key="Brush.FailedRedForeground" Color="{StaticResource Color.FailedRedForeground}"/>

    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.InfoForeground" Color="{StaticResource Color.InfoForeground}"/>


    <!-- ========================= -->
    <!-- BRUSHES -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Foreground" Color="{StaticResource Color.Foreground}"/>

    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.CardForeground" Color="{StaticResource Color.CardForeground}"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryForeground" Color="{StaticResource Color.PrimaryForeground}"/>

    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/>
    <SolidColorBrush x:Key="Brush.SecondaryForeground" Color="{StaticResource Color.SecondaryForeground}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{StaticResource Color.AccentForeground}"/>

    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.MutedForeground" Color="{StaticResource Color.MutedForeground}"/>

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}"/>
    <SolidColorBrush x:Key="Brush.Ring" Color="{StaticResource Color.Ring}"/>

    <SolidColorBrush x:Key="Brush.Destructive" Color="{StaticResource Color.Destructive}"/>
    <SolidColorBrush x:Key="Brush.DestructiveForeground" Color="{StaticResource Color.DestructiveForeground}"/>

    <SolidColorBrush x:Key="Brush.Navbar" Color="{StaticResource Color.Navbar}"/>
    <SolidColorBrush x:Key="Brush.NavbarForeground" Color="{StaticResource Color.NavbarForeground}"/>
    <SolidColorBrush x:Key="Brush.NavbarPrimary" Color="{StaticResource Color.NavbarPrimary}"/>
    <SolidColorBrush x:Key="Brush.NavbarAccent" Color="{StaticResource Color.NavbarAccent}"/>

</ResourceDictionary>
