<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Like CSS variables for light theme -->
    
    <!-- Primary Colors -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryHoverColor">#106EBE</Color>
    <Color x:Key="PrimaryActiveColor">#005A9E</Color>
    
    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F3F2F1</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextColor">#323130</Color>
    <Color x:Key="SecondaryTextColor">#605E5C</Color>
    <Color x:Key="DisabledTextColor">#A19F9D</Color>
    
    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E1DFDD</Color>
    <Color x:Key="FocusBorderColor">#0078D4</Color>
    
    <!-- Navigation Colors -->
    <Color x:Key="NavButtonDefaultColor">#FFFFFF</Color>
    <Color x:Key="NavButtonHoverColor">#F3F2F1</Color>
    <Color x:Key="NavButtonActiveColor">#0078D4</Color>
    <Color x:Key="NavIconDefaultColor">#605E5C</Color>
    <Color x:Key="NavIconHoverColor">#323130</Color>
    <Color x:Key="NavIconActiveColor">#FFFFFF</Color>
    
    <!-- Convert Colors to Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>
    
    <SolidColorBrush x:Key="NavButtonDefaultBrush" Color="{StaticResource NavButtonDefaultColor}"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="{StaticResource NavButtonHoverColor}"/>
    <SolidColorBrush x:Key="NavButtonActiveBrush" Color="{StaticResource NavButtonActiveColor}"/>
    <SolidColorBrush x:Key="NavIconDefaultBrush" Color="{StaticResource NavIconDefaultColor}"/>
    <SolidColorBrush x:Key="NavIconHoverBrush" Color="{StaticResource NavIconHoverColor}"/>
    <SolidColorBrush x:Key="NavIconActiveBrush" Color="{StaticResource NavIconActiveColor}"/>

</ResourceDictionary>