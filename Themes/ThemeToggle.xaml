                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background"
                            Value="{DynamicResource Brush.NavbarAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>-->

    </Button>

</UserControl>
