<UserControl x:Class="Master.Themes.ThemeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Master.Themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <Button x:Name="ThemeToggleBtn"
        Click="ThemeToggle_Click"
        Background="Transparent"
        BorderThickness="0"
        Padding="8"
        Cursor="Hand"
        ToolTip="Toggle Theme">

        <ui:SymbolIcon x:Name="ThemeIcon"
                   FontSize="20"
                   Foreground="{DynamicResource Brush.Foreground}"/>

