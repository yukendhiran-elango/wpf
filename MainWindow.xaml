<ui:FluentWindow x:Class="Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Master"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		xmlns:nav="clr-namespace:Master.Views.Components.NavBar"
		xmlns:header="clr-namespace:Master.Views.Components.Header">
    <Grid Background="{DynamicResource BackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- TitleBar -->
			<RowDefinition Height="Auto"/>
			<!-- Common Header -->
			<RowDefinition Height="*"/>
			<!-- Content -->
			<RowDefinition Height="Auto"/>
			<!-- Bottom Nav -->
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="WPF UI"/>

		<header:Header Grid.Row="1"/>

		<Frame x:Name="MainFrame" Grid.Row="2" NavigationUIVisibility="Hidden"/>


		
		<nav:NavBar 
			Grid.Row="3" x:Name="NavigationBar"
			HomeRequested="OnHomeRequested"
			AnalysisRequested="OnAnalysisRequested"
			MachineStatusRequested="OnMachineStatusRequested"
			ProductionRequested="OnProductionRequested"
			CurrentPage="Home"
		/>
	</Grid>
</ui:FluentWindow>
